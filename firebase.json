{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "_handoff/**",
      "_backup/**",
      "_handoff_extracted/**",
      "staging/handoff/**",
      "staging/README-staging.txt",
      "_prompt-redesign-app.md",
      "staged.ai-handoff.zip",
      "storage-cors.json",
      "_hpimg/**",
      "_hp66/**",
      "immaginiHP*.zip",
      "**/*.zip",
      "_login_extract/**",
      "staged-ai-firebase-adminsdk-*.json",
      "localStorage.hs_gkey",
      "README.md",
      "Nuovo Documento di testo.txt",
      ".claude/**",
      ".firebase/**"
    ],
    "redirects": [
      {
        "source": "/index.html",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/en/index.html",
        "destination": "/en/",
        "type": 301
      },
      {
        "source": "/guide/index.html",
        "destination": "/guide/",
        "type": 301
      },
      {
        "source": "/en/guides/index.html",
        "destination": "/en/guides/",
        "type": 301
      }
    ],
    "headers": [
      {
        "source": "/landing.html",
        "headers": [
          {
            "key": "X-Robots-Tag",
            "value": "noindex"
          }
        ]
      },
      {
        "source": "/staging/**",
        "headers": [
          {
            "key": "X-Robots-Tag",
            "value": "noindex, nofollow"
          }
        ]
      }
    ]
  }
}
